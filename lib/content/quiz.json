{
  "currency": "£",
  "rounding": 50,
  "contactAbove": 12000,
  "bands": [
    { "id": "low", "upTo": 2000 },
    { "id": "mid", "upTo": 6000 },
    { "id": "high", "upTo": 12000 }
  ],
  "steps": [
    {
      "id": "type",
      "title": "What do you need?",
      "kind": "single",
      "columns": 3,
      "options": [
        { "id": "type_new_app", "short": "New mobile app", "group": "Apps", "label": "A new mobile app", "hint": "MVP to full app" },
        { "id": "type_features", "short": "New features", "group": "Apps", "label": "New features for an existing app" },
        { "id": "type_fix", "short": "Fixes or review", "group": "Apps", "label": "Bug fixes or a code review" },
        { "id": "type_backend", "short": "Backend system", "group": "Behind the scenes", "label": "System behind an app or website", "hint": "Data, accounts, integrations" },
        { "id": "type_automation", "short": "Automation", "group": "Behind the scenes", "label": "Automation of repetitive work", "hint": "Connect your tools" },
        { "id": "type_server", "short": "Hosting setup", "group": "Behind the scenes", "label": "Hosting and server setup", "hint": "Get online and stay reliable" },
        { "id": "type_website", "short": "Website", "group": "Websites", "label": "A website", "hint": "Company or marketing site" },
        { "id": "type_unsure", "label": "I am not sure yet", "outcome": "unsure" }
      ]
    },
    {
      "id": "platform",
      "title": "Which platform?",
      "kind": "single",
      "showIf": { "type": ["type_new_app", "type_features"] },
      "options": [
        { "id": "plat_android", "short": "Android", "label": "Android only" },
        {
          "id": "plat_flutter", "short": "Android and iOS",
          "label": "Android and iOS",
          "effects": [{ "when": { "type": ["type_new_app"] }, "add": [300, 700] }]
        },
        { "id": "plat_unsure", "short": "Platform to be advised", "label": "Not sure, please advise" }
      ]
    },
    {
      "id": "size",
      "title": "How big is the project?",
      "kind": "single",
      "options": [
        {
          "id": "size_s",
          "label": "Small",
          "labels": {
            "type_new_app": "Small: 1 to 5 screens, simple flow",
            "type_features": "Small: 1 to 2 features",
            "type_fix": "Small: one focused issue or a short review",
            "type_backend": "Small: simple data storage for one app",
            "type_automation": "Small: 1 to 3 automations",
            "type_server": "Small: one app on one server",
            "type_website": "Small: 1 to 5 pages"
          }
        },
        {
          "id": "size_m",
          "label": "Medium",
          "labels": {
            "type_new_app": "Medium: 6 to 15 screens, accounts, payments or notifications",
            "type_features": "Medium: 3 to 5 features",
            "type_fix": "Medium: several issues or a full review",
            "type_backend": "Medium: user accounts, several kinds of data and integrations",
            "type_automation": "Medium: 4 to 10 automations with integrations",
            "type_server": "Medium: several services with backups and monitoring",
            "type_website": "Medium: 6 to 15 pages with a blog or CMS"
          }
        },
        {
          "id": "size_l",
          "label": "Large",
          "outcome": "contact",
          "labels": {
            "type_new_app": "Large: 16+ screens or complex logic",
            "type_features": "Large: a major rework",
            "type_fix": "Large: a whole-product audit",
            "type_backend": "Large: several connected systems or heavy logic",
            "type_automation": "Large: a wider automation programme",
            "type_server": "Large: several servers or high availability",
            "type_website": "Large: a bigger or custom-built site"
          }
        }
      ]
    },
    {
      "id": "extras",
      "title": "Is anything else included?",
      "kind": "multi",
      "showIf": { "type": ["type_new_app", "type_features"] },
      "options": [
        {
          "id": "extra_backend", "short": "Backend included",
          "label": "I also need the system behind the app",
          "hint": "For example data storage and user accounts",
          "effects": [{ "add": [650, 2100] }]
        },
        {
          "id": "extra_design", "short": "Basic design included",
          "label": "I do not have designs yet",
          "hint": "Basic interface from your sketches",
          "effects": [{ "add": [200, 500] }]
        },
        { "id": "extra_none", "short": "", "label": "Neither, I am covered", "exclusive": true }
      ]
    },
    {
      "id": "release",
      "title": "How will the app be published?",
      "kind": "single",
      "showIf": { "type": ["type_new_app"] },
      "options": [
        {
          "id": "rel_own", "short": "Own developer account",
          "label": "From my own developer account",
          "hint": "You own the app. We prepare the release and guide you through submission."
        },
        {
          "id": "rel_help", "short": "Account setup help",
          "label": "I need help setting up developer accounts",
          "hint": "Google Play and Apple accounts are created in your name.",
          "effects": [{ "add": [100, 250] }]
        },
        {
          "id": "rel_managed", "short": "We publish it",
          "label": "Please publish it for me",
          "hint": "We publish it under our own developer account. Ownership terms are agreed in writing.",
          "effects": [{ "multiply": 1.1 }]
        },
        {
          "id": "rel_later", "short": "No release yet",
          "label": "Not needed yet",
          "hint": "For example a prototype or an internal tool."
        }
      ]
    },
    {
      "id": "timeline",
      "title": "When would you like to start?",
      "kind": "single",
      "options": [
        { "id": "time_asap", "short": "", "label": "Within a month", "effects": [{ "multiply": 1 }] },
        { "id": "time_flex", "short": "", "label": "In one to three months", "effects": [{ "multiply": 1 }] },
        { "id": "time_open", "short": "", "label": "I am flexible", "effects": [{ "multiply": 1 }] }
      ]
    }
  ],
  "base": {
